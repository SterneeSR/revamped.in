# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Database Connection (for migrations / CLI)
DATABASE_URL=postgresql://postgres:password@db.your_project.supabase.co:5432/postgres

# AdSense (Optional)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE=xxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_EXAM_PAGE=xxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_PAGE=xxxxxxxxxx

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://revamped.in
NEXT_PUBLIC_SITE_NAME=revamped.in